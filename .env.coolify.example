# ==============================================================================
# DOLE CTMS - Coolify Environment Variables
# Copy and paste these into your Coolify Application > Environment Variables tab
# ==============================================================================

# Django Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key-min-50-chars
DJANGO_ALLOWED_HOSTS=*

# Domains & Origin Security (IMPORTANT: Replace with your actual domain name)
# Example: https://qms.dole.gov.ph or https://qms.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://qms.yourdomain.com
CORS_ALLOWED_ORIGINS=https://qms.yourdomain.com

# CTMS Public Base URL (Used for QR code generation and ticket links)
CTMS_BASE_URL=https://qms.yourdomain.com

# CSM Survey URL (Where clients are redirected after their transaction is marked 'Done')
CSM_SURVEY_BASE_URL=https://csm.yourdomain.com
CSM_SURVEY_WINDOW_DAYS=3

# Database Configuration
# Option 1 (Default): Uses the internal 'db' container defined in docker-compose.yaml
DB_HOST=db
DB_PORT=3306
DB_NAME=dole_csm
DB_USER=ctms
DB_PASSWORD=replace-with-a-strong-mysql-password
DB_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password

# Option 2 (External / Shared CSM MySQL):
# If connecting to the shared CSM MySQL server, uncomment and adjust:
# DB_HOST=10.6.8.96
# DB_PORT=3311
# DB_NAME=dole_csm_system
# DB_USER=mysql
# DB_PASSWORD=your_mysql_password

# Throttling
CHECKIN_THROTTLE_RATE=10/min
LOGIN_THROTTLE_RATE=5/min
